<?xml version="1.0" encoding="utf-8"?>
<!--
  Applies on API 30 only; API 31+ uses data_extraction_rules.xml.
  Forklore's database is the user's own writing, so it is backed up. Restore
  reconciliation is a known M3 concern: a restored database can be older than
  what sync holds, so sync must merge rather than assume it owns the device.
-->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
</full-backup-content>
