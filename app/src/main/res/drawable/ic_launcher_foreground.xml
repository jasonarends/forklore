<?xml version="1.0" encoding="utf-8"?>
<!-- A tilted index card — the note-card motif that runs through the whole "Handwritten ledger"
     direction (issue #15), used as the launcher glyph instead of the stock Android robot. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:name="card" android:pivotX="54" android:pivotY="54" android:rotation="-4">
        <!-- hard offset shadow (ink, no blur) -->
        <path
            android:fillColor="#2E2414"
            android:pathData="M34,29 L80,29 A3,3 0 0 1 83,32 L83,84 A3,3 0 0 1 80,87 L34,87 A3,3 0 0 1 31,84 L31,32 A3,3 0 0 1 34,29 Z" />
        <!-- card fill -->
        <path
            android:fillColor="#FBF6E9"
            android:pathData="M31,26 L77,26 A3,3 0 0 1 80,29 L80,81 A3,3 0 0 1 77,84 L31,84 A3,3 0 0 1 28,81 L28,29 A3,3 0 0 1 31,26 Z" />
        <!-- card border -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#2E2414"
            android:strokeWidth="2.5"
            android:pathData="M31,26 L77,26 A3,3 0 0 1 80,29 L80,81 A3,3 0 0 1 77,84 L31,84 A3,3 0 0 1 28,81 L28,29 A3,3 0 0 1 31,26 Z" />
        <!-- ruled lines -->
        <path android:strokeColor="#D9C9A6" android:strokeWidth="1.6" android:pathData="M36,40 L75,40" />
        <path android:strokeColor="#D9C9A6" android:strokeWidth="1.6" android:pathData="M36,50 L75,50" />
        <path android:strokeColor="#D9C9A6" android:strokeWidth="1.6" android:pathData="M36,60 L67,60" />
        <path android:strokeColor="#D9C9A6" android:strokeWidth="1.6" android:pathData="M36,70 L72,70" />
    </group>
</vector>
